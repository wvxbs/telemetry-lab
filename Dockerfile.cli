FROM python:3.12-slim

LABEL org.opencontainers.image.title="Telemetry Lab CLI" \
    org.opencontainers.image.description="Command-line HWiNFO telemetry summaries powered by Telemetry Lab" \
    org.opencontainers.image.source="https://github.com/wvxbs/telemetry-lab" \
    org.opencontainers.image.licenses="GPL-3.0-or-later" \
    org.opencontainers.image.authors="Gabriel Ferreira <gabriel.ferreira7854@gmail.com>"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY requirements-cli.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements-cli.txt

COPY LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src

ENTRYPOINT ["python", "-m", "telemetry_lab.cli"]
CMD ["--help"]
